#!/bin/zsh
set -euo pipefail

SERVER_USER="${SERVER_USER:-root}"
SERVER_HOST="${SERVER_HOST:-135.106.176.36}"
SERVER_PORT="${SERVER_PORT:-22}"
REMOTE_APP_DIR="${REMOTE_APP_DIR:-/var/www/shans-app}"
BRANCH="${1:-main}"

echo "Подключаюсь к ${SERVER_USER}@${SERVER_HOST}:${SERVER_PORT}..."
echo "Запускаю деплой Shans из ветки ${BRANCH}..."

exec ssh -p "$SERVER_PORT" "${SERVER_USER}@${SERVER_HOST}" \
  "cd '$REMOTE_APP_DIR' && APP_DIR='$REMOTE_APP_DIR' BRANCH='$BRANCH' ./deploy.sh"
