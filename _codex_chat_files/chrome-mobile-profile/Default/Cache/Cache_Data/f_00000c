    <script>
        (function () {
            const skipIntroLoader = false;
            if (skipIntroLoader) {
                document.documentElement.classList.remove("app-intro-pending");
                window.__shansShouldRunIntro = false;
                return;
            }

            function scheduleIntroFallback() {
                window.__shansIntroFallbackTimer = window.setTimeout(function () {
                    if (!document.documentElement.classList.contains("app-intro-running")) {
                        document.documentElement.classList.remove("app-intro-pending");
                    }
                }, 8000);
            }

            try {
                const standaloneDisplayMode = window.matchMedia
                    && window.matchMedia("(display-mode: standalone)").matches;
                const isStandaloneApp = standaloneDisplayMode
                    || (window.navigator && window.navigator.standalone === true);
                if (isStandaloneApp) {
                    document.documentElement.classList.remove("app-intro-pending");
                    window.__shansShouldRunIntro = false;
                    return;
                }

                const introKey = "shans-intro-session-v1";
                let introAlreadyShown = false;
                try {
                    introAlreadyShown = Boolean(
                        window.sessionStorage
                        && window.sessionStorage.getItem(introKey)
                    );
                    if (!introAlreadyShown && window.sessionStorage) {
                        window.sessionStorage.setItem(introKey, "1");
                    }
                } catch (storageError) {
                    introAlreadyShown = false;
                }

                if (introAlreadyShown) {
                    document.documentElement.classList.remove("app-intro-pending");
                    window.__shansShouldRunIntro = false;
                    return;
                }

                window.__shansShouldRunIntro = true;
                scheduleIntroFallback();
            } catch (error) {
                // Keep the first-visit intro available in constrained browser contexts.
                window.__shansShouldRunIntro = true;
                scheduleIntroFallback();
            }
        }());
    </script>
