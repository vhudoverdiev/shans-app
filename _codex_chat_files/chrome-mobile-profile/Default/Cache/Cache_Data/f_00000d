        document.addEventListener("DOMContentLoaded", function () {
            function applyAvatarFallback(image) {
                if (!image) return;
                const fallbackLetter = image.dataset && image.dataset.fallbackLetter ? image.dataset.fallbackLetter : "?";
                const parent = image.parentElement;
                if (!parent) return;
                image.remove();
                parent.textContent = fallbackLetter;
            }

            const avatarImages = document.querySelectorAll(".js-avatar-image");
            avatarImages.forEach(function (image) {
                image.addEventListener("error", function () {
                    applyAvatarFallback(image);
                });
            });

            const confirmModal = document.getElementById("confirm-modal");
            const confirmModalApprove = document.getElementById("confirm-modal-approve");
            const confirmModalCancel = document.getElementById("confirm-modal-cancel");
            const validationToast = document.getElementById("validation-toast");
            let confirmResolver = null;
            let validationToastTimer = null;

            function showValidationToast(message) {
                if (!validationToast) return;
                validationToast.textContent = message || "Заполните это поле.";
                validationToast.classList.add("validation-toast-show");
                if (validationToastTimer) {
                    window.clearTimeout(validationToastTimer);
                }
                validationToastTimer = window.setTimeout(function () {
                    validationToast.classList.remove("validation-toast-show");
                }, 2200);
            }

            function openConfirmDialog() {
                if (!confirmModal || !confirmModalApprove || !confirmModalCancel) {
                    return Promise.resolve(window.confirm("Вы точно хотите удалить?"));
                }
                confirmModal.hidden = false;
                return new Promise(function (resolve) {
                    confirmResolver = resolve;
                });
            }

            function closeConfirmDialog(approved) {
                if (!confirmModal) return;
                confirmModal.hidden = true;
                if (confirmResolver) {
                    confirmResolver(Boolean(approved));
                    confirmResolver = null;
                }
            }

            if (confirmModalApprove && confirmModalCancel && confirmModal) {
                confirmModalApprove.addEventListener("click", function () { closeConfirmDialog(true); });
                confirmModalCancel.addEventListener("click", function () { closeConfirmDialog(false); });
                confirmModal.addEventListener("click", function (event) {
                    if (event.target.classList.contains("confirm-modal-backdrop")) {
                        closeConfirmDialog(false);
                    }
                });
            }

            const csrfMeta = document.querySelector("meta[name='csrf-token']");
            const csrfToken = csrfMeta ? csrfMeta.getAttribute("content") : "";

            function injectCsrfTokens(scope) {
                if (!csrfToken) {
                    return;
                }
                (scope || document).querySelectorAll("form").forEach(function (form) {
                    const method = (form.getAttribute("method") || "GET").toUpperCase();
                    if (method !== "POST") {
                        return;
                    }
                    if (form.querySelector("input[name='_csrf_token']")) {
                        return;
                    }
                    const hidden = document.createElement("input");
                    hidden.type = "hidden";
                    hidden.name = "_csrf_token";
                    hidden.value = csrfToken;
                    form.appendChild(hidden);
                });
            }

            injectCsrfTokens(document);
            document.addEventListener("shans:ajax-updated", function () {
                injectCsrfTokens(document);
            });

            const navToggle = document.getElementById("mobile-nav-toggle");
            const navMenu = document.getElementById("top-nav-menu");
            if (navToggle && navMenu) {
                navToggle.addEventListener("click", function () {
                    const isOpen = navMenu.classList.toggle("top-nav-open");
                    navToggle.setAttribute("aria-expanded", isOpen ? "true" : "false");
                });
            }

            document.querySelectorAll(".data-table").forEach(function (table) {
                const headers = Array.from(table.querySelectorAll("thead th")).map(function (th) {
                    return th.textContent.trim();
                });

                table.querySelectorAll("tbody tr").forEach(function (row) {
                    row.querySelectorAll("td").forEach(function (cell, index) {
                        if (headers[index]) {
                            cell.setAttribute("data-label", headers[index]);
                        }
                    });
                });
            });

            document.querySelectorAll(".table-card").forEach(function (card) {
                const bulkActions = card.querySelector(".bulk-table-actions");
                if (!bulkActions) return;

                const hasDataRows = card.querySelectorAll(".bulk-row-checkbox").length > 0;
                if (!hasDataRows) {
                    card.classList.add("bulk-selection-hidden");
                    bulkActions.classList.add("bulk-actions-hidden");
                }
            });

            document.querySelectorAll(".bulk-table").forEach(function (wrapper) {
                const scope = wrapper.closest(".table-card") || wrapper.parentElement || wrapper;
                const selectedForm = scope.querySelector(".bulk-delete-selected-form");
                const allForm = scope.querySelector(".bulk-delete-all-form");
                const bulkActions = (selectedForm && selectedForm.closest(".table-actions"))
                    || (allForm && allForm.closest(".table-actions"));
                const selectAll = wrapper.querySelector(".bulk-select-all");
                const checkboxes = Array.from(wrapper.querySelectorAll(".bulk-row-checkbox"));
                const rows = Array.from(wrapper.querySelectorAll("tbody tr"));
                const hasBulkControls = Boolean(selectedForm || allForm);
                const hasDataRows = checkboxes.length > 0;
                let selectionMode = false;
                let actionsVisible = false;
                let cancelBtn = null;

                if (hasBulkControls && bulkActions && hasDataRows) {
                    cancelBtn = document.createElement("button");
                    cancelBtn.type = "button";
                    cancelBtn.className = "btn btn-small bulk-cancel-selection-btn";
                    cancelBtn.textContent = "Отмена";
                    bulkActions.appendChild(cancelBtn);
                }

                function setSelectionMode(enabled) {
                    if (!hasBulkControls || !bulkActions || !hasDataRows) return;
                    selectionMode = enabled;
                    scope.classList.toggle("bulk-selection-hidden", !enabled);
                    actionsVisible = false;
                    bulkActions.classList.add("bulk-actions-hidden");
                }

                function syncState() {
                    const checked = checkboxes.filter(function (item) { return item.checked; }).length;
                    if (selectedForm) {
                        const idsField = selectedForm.querySelector(".bulk-selected-ids");
                        if (idsField) {
                            idsField.value = checkboxes
                                .filter(function (item) { return item.checked; })
                                .map(function (item) { return item.value; })
                                .join(",");
                        }
                        const btn = selectedForm.querySelector("button[type='submit']");
                        if (btn) {
                            btn.disabled = checked === 0;
                        }
                    }
                    if (selectAll) {
                        selectAll.checked = checked > 0 && checked === checkboxes.length;
                        selectAll.indeterminate = checked > 0 && checked < checkboxes.length;
                    }
                }

                function resetSelection() {
                    if (selectAll) {
                        selectAll.checked = false;
                        selectAll.indeterminate = false;
                    }
                    checkboxes.forEach(function (item) {
                        item.checked = false;
                    });
                    syncState();
                }

                function showBulkActions() {
                    if (!hasBulkControls || !bulkActions || !selectionMode || !hasDataRows) return;
                    if (!actionsVisible) {
                        bulkActions.classList.remove("bulk-actions-hidden");
                        actionsVisible = true;
                    }
                }

                function toggleBulkActionsBySelection() {
                    if (!hasBulkControls || !bulkActions || !selectionMode || !hasDataRows) return;
                    const checked = checkboxes.filter(function (item) { return item.checked; }).length;
                    if (checked === 0) {
                        bulkActions.classList.add("bulk-actions-hidden");
                        actionsVisible = false;
                        return;
                    }
                    showBulkActions();
                }

                function hideEverything() {
                    resetSelection();
                    setSelectionMode(false);
                }

                if (selectAll) {
                    selectAll.addEventListener("change", function () {
                        checkboxes.forEach(function (item) { item.checked = selectAll.checked; });
                        syncState();
                        toggleBulkActionsBySelection();
                    });
                }

                checkboxes.forEach(function (item) {
                    item.addEventListener("change", function () {
                        syncState();
                        toggleBulkActionsBySelection();
                    });
                });

                rows.forEach(function (row) {
                    row.addEventListener("dblclick", function () {
                        if (!hasDataRows) return;
                        if (selectionMode) {
                            hideEverything();
                            return;
                        }
                        setSelectionMode(true);
                    });
                });

                if (cancelBtn) {
                    cancelBtn.addEventListener("click", function () {
                        hideEverything();
                    });
                }

                if (selectedForm) {
                    selectedForm.addEventListener("submit", async function (event) {
                        const idsField = selectedForm.querySelector(".bulk-selected-ids");
                        if (!idsField || !idsField.value) {
                            event.preventDefault();
                            return;
                        }
                        event.preventDefault();
                        const approved = await openConfirmDialog();
                        if (!approved) {
                            return;
                        }
                        selectedForm.submit();
                    });
                }

                if (allForm) {
                    allForm.addEventListener("submit", async function (event) {
                        event.preventDefault();
                        if (selectionMode && hasDataRows) {
                            if (selectAll) {
                                selectAll.checked = true;
                                selectAll.indeterminate = false;
                            }
                            checkboxes.forEach(function (item) { item.checked = true; });
                            syncState();
                        }
                        const approved = await openConfirmDialog();
                        if (!approved) {
                            return;
                        }
                        allForm.submit();
                    });
                }

                if (!hasDataRows) {
                    scope.classList.add("bulk-selection-hidden");
                    if (bulkActions) {
                        bulkActions.classList.add("bulk-actions-hidden");
                    }
                } else {
                    setSelectionMode(false);
                }
                syncState();
            });

            document.addEventListener("submit", async function (event) {
                const form = event.target;
                if (!(form instanceof HTMLFormElement)) return;
                if (form.dataset.confirmHandled === "1") return;

                const onsubmit = form.getAttribute("onsubmit") || "";
                const action = form.getAttribute("action") || "";
                const button = event.submitter;
                const submitTitle = button && button.getAttribute ? (button.getAttribute("title") || "").toLowerCase() : "";
                const hasDeleteIntent = /confirm\(/i.test(onsubmit) || action.includes("/delete") || submitTitle.includes("удал");
                if (!hasDeleteIntent) return;

                event.preventDefault();
                event.stopImmediatePropagation();
                const approved = await openConfirmDialog();
                if (!approved) return;

                form.dataset.confirmHandled = "1";
                form.submit();
                form.dataset.confirmHandled = "0";
            }, true);

            document.querySelectorAll("tr[data-href]").forEach(function (row) {
                row.addEventListener("click", function (event) {
                    if (event.target.closest("form, button, a, input, label")) return;

                    const tableCard = row.closest(".table-card");
                    const bulkActions = tableCard ? tableCard.querySelector(".bulk-table-actions") : null;
                    if (bulkActions && !bulkActions.classList.contains("bulk-actions-hidden")) {
                        event.preventDefault();
                        return;
                    }

                    const href = row.dataset.href;
                    if (href) {
                        window.location.href = href;
                    }
                });
            });

            const strictDatePattern = /^\d{4}-\d{2}-\d{2}$/;
            document.querySelectorAll("input[type='date']").forEach(function (input) {
                function validateDateField() {
                    if (!input.value) {
                        input.setCustomValidity("");
                        return;
                    }

                    if (!strictDatePattern.test(input.value)) {
                        input.setCustomValidity("Год должен состоять строго из 4 цифр.");
                        return;
                    }

                    const [year, month, day] = input.value.split("-").map(function (value) {
                        return Number(value);
                    });
                    const candidate = new Date(Date.UTC(year, month - 1, day));
                    const isValidDate = candidate.getUTCFullYear() === year
                        && candidate.getUTCMonth() === month - 1
                        && candidate.getUTCDate() === day;
                    input.setCustomValidity(isValidDate ? "" : "Введите корректную дату.");
                }

                input.addEventListener("input", validateDateField);
                input.addEventListener("change", validateDateField);
                validateDateField();
            });

            document.addEventListener("invalid", function (event) {
                const input = event.target;
                if (!(input instanceof HTMLElement)) return;
                const message = input.validationMessage || "Заполните это поле.";
                showValidationToast(message);
            }, true);

            document.addEventListener("input", function (event) {
                const input = event.target;
                if (!(input instanceof HTMLElement)) return;
                if (!input.matches("input, textarea, select")) return;
                if (input.checkValidity()) {
                    if (validationToastTimer) {
                        window.clearTimeout(validationToastTimer);
                        validationToastTimer = null;
                    }
                    if (validationToast) {
                        validationToast.classList.remove("validation-toast-show");
                    }
                }
            });
        });
    </script>
    
